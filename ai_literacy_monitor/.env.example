# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Zotero API key — get from https://www.zotero.org/settings/keys/new
# Grant "Write" access to the group library you configure in config.yaml.
ZOTERO_API_KEY=your_zotero_api_key_here

# SMTP password for the sending address configured in config.yaml
SMTP_PASSWORD=your_smtp_password_here
